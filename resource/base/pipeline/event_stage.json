{
    "EventStage.CheckHomePage": {
        "desc": "确认当前是否在游戏主页",
        "recognition": "TemplateMatch",
        "roi": [
            1199,
            6,
            77,
            83
        ],
        "template": "main_option.png",
        "threshold": 0.8,
        "pre_delay": 500,
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    588,
                    369,
                    9,
                    11
                ]
            }
        },
        "repeat": 2,
        "repeat_delay": 500,
        "timeout": 5000,
        "next": [
            "EventStage.Start",
            "[JumpBack]EventStage.ReturnMain"
        ],
        "on_error": [
            "EventStage.ReturnToHome"
        ]
    },
    "EventStage.Start": {
        "desc": "从主页 TemplateMatch 识别左侧活动入口上方的「耀斑」艺术字并点击，进入活动主页 event7 [错误兜底: ReturnMain]",
        "recognition": "TemplateMatch",
        "roi": [
            0,
            130,
            520,
            250
        ],
        "template": [
            "event_stage/flare_title.png",
            "event_stage/flare_title_plain.png"
        ],
        "threshold": 0.7,
        "pre_delay": 500,
        "action": {
            "type": "Click"
        },
        "post_delay": 1500,
        "timeout": 20000,
        "next": [
            "EventStage.EventHub"
        ],
        "on_error": [
            "EventStage.ReturnMain"
        ]
    },
    "EventStage.EventHub": {
        "desc": "活动主页 event7：包含踏上征途（战斗）和战果上报（商店）两个入口",
        "recognition": "DirectHit",
        "action": {
            "type": "DoNothing"
        },
        "next": [
            "EventStage.ClickJourney",
            "EventStage.ClickBattleReport"
        ]
    },
    "EventStage.ClickJourney": {
        "desc": "点击踏上征途进入关卡选择（event7 右下角，精确裁剪文字区域后 OCR）",
        "recognition": "OCR",
        "roi": [
            920,
            570,
            320,
            100
        ],
        "expected": "踏上征途",
        "only_rec": true,
        "threshold": 0.5,
        "pre_delay": 500,
        "action": {
            "type": "Click"
        },
        "post_delay": 2000,
        "next": [
            "EventStage.WaitStageMapStable"
        ]
    },
    "EventStage.WaitStageMapStable": {
        "desc": "等待 EX 关卡地图画面稳定",
        "recognition": "DirectHit",
        "action": {
            "type": "DoNothing"
        },
        "post_wait_freezes": 1000,
        "next": [
            "EventStage.ClickEP2"
        ]
    },
    "EventStage.FindTargetStage": {
        "desc": "识别当前视口中的目标 EX 关卡；未找到时进入单次慢速滑动",
        "recognition": "Custom",
        "custom_recognition": "CheckEventStage",
        "custom_recognition_param": "{\"stage_name\": \"EX2-1\", \"stage_roi\": [0, 0, 1280, 640]}",
        "pre_delay": 200,
        "action": {
            "type": "Click"
        },
        "post_delay": 500,
        "next": [
            "EventStage.CheckStageEntryResult"
        ],
        "on_error": [
            "EventStage.DragFindStage"
        ]
    },
    "EventStage.DragFindStage": {
        "desc": "目标未出现时向左拖动地图（露出右侧关卡）并重试（最多 8 次）",
        "max_hit": 8,
        "recognition": "DirectHit",
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [
                    950,
                    400
                ],
                "end": [
                    350,
                    400
                ],
                "duration": 1200
            }
        },
        "post_delay": 1000,
        "next": [
            "EventStage.FindTargetStage"
        ]
    },
