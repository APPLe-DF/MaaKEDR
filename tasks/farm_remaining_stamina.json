{
    "task": [
        {
            "name": "剩余体力刷取",
            "entry": "FarmResources.CheckHomePage",
            "default_check": false,
            "group": [
                "Daily"
            ],
            "description": "仅刷剩余体力（固定清空体力模式）：刷到体力不足自动减次退出，榨干剩余体力。需选择刷取板块",
            "option": [
                "remaining_farm_category"
            ],
            "pipeline_override": {
                "FarmResources.QuickBattle": {
                    "next": [
                        "FarmResources.SetBattleCountMax"
                    ]
                },
                "FarmResources.ClickStage": {
                    "next": [
                        "FarmResources.QuickBattle",
                        "FarmResources.SetBattleCountMax"
                    ]
                },
                "FarmResources.ClickSkillStage": {
                    "next": [
                        "FarmResources.QuickBattle",
                        "FarmResources.SetBattleCountMax"
                    ]
                },
                "FarmResources.CheckStamina": {
                    "next": [
                        "FarmResources.CheckCountOCR",
                        "FarmResources.ReduceCount"
                    ]
                },
                "FarmResources.BattleStage": {
                    "next": [
                        "[JumpBack]FarmResources.ClickVictory",
                        "[JumpBack]FarmResources.ClickItemDialog",
                        "FarmResources.QuickBattle",
                        "FarmResources.ReturnMainFromFarm",
                        "FarmResources.PrepareBattle"
                    ]
                },
                "FarmResources.ExitStageConfirm": {
                    "next": [
                        "FarmResources.ReturnMainFromFarm"
                    ]
                }
            }
        }
    ],
    "option": {
        "remaining_farm_category": {
            "type": "select",
            "label": "刷取板块",
            "default_case": "资源收集",
            "cases": [
                {
                    "name": "资源收集",
                    "label": "资源收集",
                    "option": [
                        "remaining_farm_resource_type"
                    ],
                    "pipeline_override": {
                        "FarmResources.Start": {
                            "next": [
                                "FarmResources.ResourceCollect"
                            ]
                        }
                    }
                },
                {
                    "name": "技能演练",
                    "label": "技能演练",
                    "option": [
                        "remaining_farm_skill_type"
                    ],
                    "pipeline_override": {
                        "FarmResources.Start": {
                            "next": [
                                "FarmResources.SkillTraining"
                            ]
                        }
                    }
                }
            ]
        },
        "remaining_farm_resource_type": {
            "type": "select",
            "label": "资源类型",
            "default_case": "特别军费行动",
            "cases": [
                {
                    "name": "特别军费行动",
                    "label": "特别军费行动",
                    "option": [
                        "remaining_farm_resource_stage_1"
                    ],
                    "pipeline_override": {
                        "FarmResources.SelectResourceType": {
                            "next": [
                                "FarmResources.SelectSpecialFunds"
                            ]
                        }
                    }
                },
                {
                    "name": "作战体能训练",
                    "label": "作战体能训练",
                    "option": [
                        "remaining_farm_resource_stage_2"
                    ],
                    "pipeline_override": {
                        "FarmResources.SelectResourceType": {
                            "next": [
                                "FarmResources.SelectPhysicalTraining"
                            ]
